								<Code><![CDATA[v_currentWIP2 = (Machine_WIP)agent;
temp_CO2L2 += ((Machine_WIP)agent).v_CO2Footprint;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter2]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[temp_CO2L2 += ((Component)agent).v_CO2Footprint;]]></Code>
							</Value>
