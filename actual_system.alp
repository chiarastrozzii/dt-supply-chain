					<Id>1775321939100</Id>
					<Name><![CDATA[orderComplete]]></Name>
					<X>1540</X><Y>810</Y>
					<Label><X>-10</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Sink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Sink]]></ClassName>
							<ItemName><![CDATA[1412336242929]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[double carbonRatio = (agent.p_finalDistance > 0) ? (agent.v_CO2Footprint / agent.p_finalDistance) : 0;
double activePFlorries = fleetPF.size() - fleetPF.idle();
double priceDifference = v_competitorPrice - v_productPrice;

results.println(
   agent.p_orderID + "," + 
    agent.p_targetCenter + "," +
    agent.p_logicCenterName + "," + 
    agent.v_waitOrder + "," +        
    agent.v_waitLogicCenter + "," +  
    agent.p_finalDistance + "," + 
    (time() - agent.p_startTime) + "," +
    date() + "," + 
    agent.v_CO2Footprint + "," +
    carbonRatio + "," +
    getMarketIndex() + "," +
    v_competitorPrice + "," +
    v_productPrice + "," +
    priceDifference + "," +
    activePFlorries
);


py.run("send_to_dashboard(" + 
    agent.p_orderID + ",'" + 
    agent.p_logicCenterName + "'," +
    agent.v_waitOrder + "," + 
    agent.v_waitLogicCenter + "," +
    agent.v_CO2Footprint + ",'" +
    date() + "'," +
    agent.orderEntryTime + "," +
    carbonRatio + "," +
    getMarketIndex() + "," +
    v_competitorPrice + "," +
    v_productPrice + "," +
    activePFlorries + ")");

traceln("Dati salvati per Ordine: " + agent.p_orderID);]]></Code>
							</Value>
						</Parameter>
