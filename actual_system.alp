						<Parameter>
							<Name><![CDATA[onEnterDelay]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
agent.v_waitLogicCenter = time() - v_currentWIP2.v_entryTime;
agent.orderEntryTime = v_currentWIP2.orderEntryTime;

agent.p_orderID = v_currentWIP2.p_orderID;
agent.p_targetCenter = v_currentWIP2.p_targetCenter;
agent.p_finalDistance = v_currentWIP2.p_finalDistance;
agent.p_startTime = v_currentWIP2.p_startTime;
agent.v_waitOrder = v_currentWIP2.v_waitOrder;

double leadTime = time() - v_currentWIP2.p_startTime;

//traceln("Order #" + agent.p_orderID + " finished at Center " + agent.p_targetCenter + ". Logic Center Process Time: " + leadTime);]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[((FinalProduct)agent).v_CO2Footprint = temp_CO2L2;

temp_CO2L2 = 0;

((FinalProduct)agent).v_startLat = agent.getLatitude();
((FinalProduct)agent).v_startLon = agent.getLongitude();

agent.p_logicCenterName = self.getName();

//traceln("Milan Product Ready. Total CO2: " + ((FinalProduct)agent).v_CO2Footprint);]]></Code>
							</Value>
						</Parameter>
