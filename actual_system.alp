<Model>
	<Id>1773921268615</Id>
	<Name><![CDATA[actual_system]]></Name>
	<EngineVersion>6</EngineVersion>
	<JavaPackageName><![CDATA[test_chain]]></JavaPackageName>
	<ModelTimeUnit><![CDATA[Hour]]></ModelTimeUnit>
	<Folders>
	</Folders>
	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1773921268619</Id>
			<Name><![CDATA[Main]]></Name>
			<Import><![CDATA[import java.util.Scanner;]]></Import>
			<StartupCode><![CDATA[try {
   	results.println("OrderID,TargetCenter,LogicCenterName,WaitOrder,WaitLogicCenter,Distance,ProcessingTime,FinishTime,CO2PerOrder,CarbonRatio,MarketIndex,CompetitorPrice,ProductPrice,PriceDifference,activeFloorLorries");
   	traceln("results file ready");
    String path = "config.json"; 
    String content = new String(java.nio.file.Files.readAllBytes(java.nio.file.Paths.get(path)));
    content = content.replaceAll("[\\{\\}\"\\s\\[\\]]", "");
    String[] lines = content.split(",");

    this.p_ArrivalRate   = (int)Double.parseDouble(lines[0].split(":")[1]);
    this.p_BufferOrders = (int)Double.parseDouble(lines[1].split(":")[1]);
    this.p_MaxWaitLimit = Double.parseDouble(lines[2].split(":")[1]);
    this.p_capacityLC1 = (int)Double.parseDouble(lines[3].split(":")[1]);
    this.p_capacityLC2 = (int)Double.parseDouble(lines[4].split(":")[1]);
    this.p_capacityLC3 = (int)Double.parseDouble(lines[5].split(":")[1]);
    this.p_emissionFactor = Double.parseDouble(lines[6].split(":")[1]);
    
    orderBuffer.set_capacity(this.p_BufferOrders);
    bufferCenter1.set_capacity(this.p_capacityLC1);
    bufferCenter2.set_capacity(this.p_capacityLC2);
    bufferCenter3.set_capacity(this.p_capacityLC3);
    
    for(int i = 0; i < lines.length; i++) {
        if(lines[i].contains("sourceS1")) {
            this.v_lorriesS1 = (int)Double.parseDouble(lines[i+1].split(":")[1]);
            this.v_unitsS1   = (int)Double.parseDouble(lines[i+2].split(":")[1]);
        } else if(lines[i].contains("sourceS2")) {
            this.v_lorriesS2 = (int)Double.parseDouble(lines[i+1].split(":")[1]);
            this.v_unitsS2   = (int)Double.parseDouble(lines[i+2].split(":")[1]);
        } else if(lines[i].contains("sourceS3")) {
            this.v_lorriesS3 = (int)Double.parseDouble(lines[i+1].split(":")[1]);
            this.v_unitsS3   = (int)Double.parseDouble(lines[i+2].split(":")[1]);
        } else if(lines[i].contains("sourceS4")) {
            this.v_lorriesS4 = (int)Double.parseDouble(lines[i+1].split(":")[1]);
            this.v_unitsS4   = (int)Double.parseDouble(lines[i+2].split(":")[1]);
        } else if(lines[i].contains("productionFloor")) {
    		this.v_lorriesPF = (int)Double.parseDouble(lines[i+1].split(":")[1]);
    		this.v_unitsPF   = (int)Double.parseDouble(lines[i+2].split(":")[1]);
}
    }
    
    fleetS1.set_capacity(v_lorriesS1);
	fleetS2.set_capacity(v_lorriesS2);
	fleetS3.set_capacity(v_lorriesS3);
	fleetS4.set_capacity(v_lorriesS4);
	fleetPF.set_capacity(v_lorriesPF);
    
    traceln("JSON SUCCESS: Parameters loaded.");
    
    py.run("from brain import *"); 
    traceln("PYTHON SUCCESS: brain.py functions are now live.");
    
    String currentSchedule = getScheduleDescription();
	py.run("set_schedule_info('" + currentSchedule + "')");
	
	eventArrivalTrigger.restart(0, HOUR);
	

} catch (Exception e) {
    traceln("STARTUP ERROR: " + e.getMessage());
    p_ArrivalRate = 1;
    p_BufferOrders = 50;
}]]></StartupCode>
			<DestroyCode><![CDATA[results.close();]]></DestroyCode>
