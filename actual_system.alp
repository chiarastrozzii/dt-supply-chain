					<BasicProperties Width="200" Height="30">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[try {
    // 1. Calcolo della media (getYMean è lo standard AnyLogic)
    double averageWaitTime = 0;
    // 2. Prepariamo il comando
    String command = "check_bottleneck(" + averageWaitTime + ", " + p_MaxWaitLimit + ")";
    
    // 3. Usiamo runResults (come dice la doc per avere indietro il valore)
    // Passiamo String.class come primo argomento per avere direttamente il testo
    //String result = py.runResults(String.class, command);
    
    // 4. Stampiamo in console
    traceln("TEMPO MEDIO: " + averageWaitTime);
    //traceln("PYTHON MONITOR: " + result);
    py.run("import sys; print(sys.executable)");

} catch (Exception e) {
    traceln("ERRORE DI COMUNICAZIONE: " + e.getMessage());
}]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="Dialog" Size="11" Style="0"/>
						<LabelText><![CDATA[Test Python Communication]]></LabelText>
					</ExtendedProperties>
				</Control>
			</Presentation>

