						<Parameter>
							<Name><![CDATA[onEnter1]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[double currentWait = time() - ((Order)agent).p_arrivalFactory;
((Order)agent).v_tempWait = currentWait;

v_processingOrder = (Order)agent;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter2]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[tempAssemblerCO2 += ((Component)agent).v_CO2Footprint;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter3]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[tempAssemblerCO2 += ((Component)agent).v_CO2Footprint;]]></Code>
							</Value>
						</Parameter>
