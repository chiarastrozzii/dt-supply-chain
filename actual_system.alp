						<Parameter>
							<Name><![CDATA[onEnter5]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnterDelay]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
agent.v_waitOrder = v_processingOrder.v_tempWait; 
agent.orderEntryTime = v_processingOrder.entryTimestamp;
//traceln("wait order at exit of floor: " + agent.v_waitOrder);

agent.p_orderID = v_processingOrder.p_orderID;
agent.p_targetCenter = v_processingOrder.p_targetCenter;
agent.p_finalDistance = v_processingOrder.p_finalDistance;
agent.p_startTime = v_processingOrder.p_startTime;
agent.p_C4 = v_processingOrder.p_C4;

agent.setLatLon(productionFloor.getLatitude(), productionFloor.getLongitude());

for(int i=0; i < agent.p_C4; i++) { 
    sourceS4.inject(); 
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
