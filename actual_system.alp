						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
	agent.p_orderID = v_orderCount++;
	agent.p_startTime = time();
	agent.p_C1 = (int)uniform_discr(3, 10);
	agent.p_C2 = (int)uniform_discr(3, 10);
	agent.p_C3 = (int)uniform_discr(3, 10);
	agent.p_C4 = (int)uniform_discr(2, 6);

	agent.p_custLat = uniform(44.5, 47.0); //create orders from location of the map, stochastic
	agent.p_custLon = uniform(7.5, 14.0);

	agent.p_priority = (int)uniform_discr(1, 3);
	agent.p_deliveryDeadline = time() + 24;

	double d1 = map.getDistanceByRoute(agent.p_custLat, agent.p_custLon, MilanLC2.getLatitude(), MilanLC2.getLongitude()) / 1000.0;
	double d2 = map.getDistanceByRoute(agent.p_custLat, agent.p_custLon, VeronaLC3.getLatitude(), VeronaLC3.getLongitude()) / 1000.0;
	double d3 = map.getDistanceByRoute(agent.p_custLat, agent.p_custLon, BolzanoLC1.getLatitude(), BolzanoLC1.getLongitude()) / 1000.0;

	int destination = 0;
	if (d1 <= d2 && d1 <= d3) {
    	if (bufferCenter1.size() < p_capacityLC1) destination = 1;
    	else if (bufferCenter2.size() < p_capacityLC2) destination = 2;
    	else destination = 3;
	}else if (d2 <= d1 && d2 <= d3){
		if (bufferCenter2.size() < p_capacityLC2) destination = 2;
    	else if (bufferCenter1.size() < p_capacityLC1) destination = 1;
    	else destination = 3;
	}else {
		if (bufferCenter3.size() < p_capacityLC3) destination = 3;
    	else if (bufferCenter1.size() < p_capacityLC1) destination = 1;
    	else destination = 2;
	}

	if(destination == 1) agent.p_finalDistance = d1;
	else if(destination == 2) agent.p_finalDistance = d2;
	else agent.p_finalDistance = d3;

	agent.setXYZ(agent.p_custLat, agent.p_custLon, 0);

	agent.p_targetCenter = destination;
	v_currentTarget = destination; //for the component C4
	this.v_tempOrderID = agent.p_orderID;

	for(int i=0; i < agent.p_C1; i++) { sourceS1.inject(); }
	for(int i=0; i < agent.p_C2; i++) { sourceS2.inject(); }
	for(int i=0; i < agent.p_C3; i++) { sourceS3.inject(); }

	//traceln("Order " + agent.p_orderID + " created and assigned to Center " + destination);

]]></Code>
							</Value>
