							<Value Class="CodeValue">
								<Code><![CDATA[agent.v_waitLogicCenter = time() - v_currentWIP1.v_entryTime;
agent.orderEntryTime = v_currentWIP1.orderEntryTime;

agent.p_orderID = v_currentWIP1.p_orderID;
agent.p_targetCenter = v_currentWIP1.p_targetCenter;
agent.p_finalDistance = v_currentWIP1.p_finalDistance;
agent.p_startTime = v_currentWIP1.p_startTime;
agent.v_waitOrder = v_currentWIP1.v_waitOrder;

double leadTime = time() - v_currentWIP1.p_startTime;

//traceln("Order #" + agent.p_orderID + " finished at Center " + agent.p_targetCenter + ". Logic Center Process Time: " + leadTime);]]></Code>
							</Value>
