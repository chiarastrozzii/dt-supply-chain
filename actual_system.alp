			<Events>
				<Event>
					<Id>1778076931046</Id>
					<Name><![CDATA[eventArrivalTrigger]]></Name>
					<X>90</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="userControls">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[orderSchedule.getValue() ? (p_ArrivalRate * v_macroSeasonalMul * v_microDailyMul) : 0.0]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<Id>1778076931044</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1778140800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[8]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1/p_ArrivalRate]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// 1. If the schedule is active right now, generate an order
if (orderSchedule.getValue() == true) {
    sourceOrders.inject();
    py.run("update_factory_status(True)");
}else{
	py.run("update_factory_status(False)");
}

double hourlyNoise = uniform(1.0, 0.10); // +/- 15% random chaos
// 2. Calculate your hourly arrival rate dynamically using your variables
double hourlyRate = orderSchedule.getValue() ? ((p_ArrivalRate / 24.0) * v_macroSeasonalMul * v_microDailyMul * hourlyNoise) : 0.0;

// 3. Schedule the exact time for the next arrival using a true Poisson distribution
if (hourlyRate > 0) {
    double nextArrivalGap = exponential(hourlyRate); // True random arrival gap
    eventArrivalTrigger.restart(nextArrivalGap, HOUR);
} else {
    eventArrivalTrigger.restart(0.25, HOUR); // If off-shift, check back in 15 minutes
}]]></Action>
				</Event>
				<Event>
					<Id>1779106389068</Id>
					<Name><![CDATA[competitorPrice]]></Name>
					<X>1610</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1779106389066</Id>
						<OccurrenceAtTime>false</OccurrenceAtTime>
						<OccurrenceDate>1772409600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[7]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double currentHour = time();
int currentDay = ((int)(currentHour / 24)) % 365;

double compBasePrice = 210.0;
double compPriceSwingRange = 25.0;

double compPriceRadians = 2 * Math.PI * (currentDay - 15) / 365;
//peak in winter
double peakSeasons = -compPriceSwingRange * Math.cos(compPriceRadians);

//higher variance to show they are less stable
double compStandardDeviation = 4.0; 
double compMean = 0.0;
double compMarketNoise = normal(compMean, compStandardDeviation);

v_competitorPrice = compBasePrice + peakSeasons + compMarketNoise;

if (v_competitorPrice < 130.0) {
    v_competitorPrice = 130.0;
}]]></Action>
				</Event>
				<Event>
					<Id>1779278503885</Id>
					<Name><![CDATA[productPrice]]></Name>
					<X>1740</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1779278503883</Id>
						<OccurrenceAtTime>false</OccurrenceAtTime>
						<OccurrenceDate>1772409600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[7]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double currentHour = time();
int currentDay = ((int)(currentHour / 24)) % 365;

double basePrice = 200.0;
double priceSwingRange = 30.0;

double priceRadians = 2 * Math.PI * (currentDay - 15) / 365;
double strategicPriceComponent = -priceSwingRange * Math.cos(priceRadians);

double standardDeviation = 2.5; 
double mean = 0.0;
double dailyMarketNoise = normal(mean, standardDeviation);

v_productPrice = basePrice + strategicPriceComponent + dailyMarketNoise;

if (v_productPrice < 120.0) {
    v_productPrice = 120.0;
}]]></Action>
				</Event>
				<Event>
					<Id>1779357245997</Id>
					<Name><![CDATA[updateSeasonality]]></Name>
					<X>-130</X><Y>660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1779357245995</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779436800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.25]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[v_currentDayOfYear = ((int)(time() / 24)) % 365;
v_currentHourOfDay = time() % 24;

//peaks in winter and drops in summer
double yearlyRadians = 2 * Math.PI * (v_currentDayOfYear - 15) / 365;
v_macroSeasonalMul = Math.max(0.2, 1.0 - 0.5 * Math.cos(yearlyRadians));

double dailyBaseline = 0.1;
if (v_currentHourOfDay >= 8.0 && v_currentHourOfDay <= 18.0) {
    
    if (v_currentHourOfDay >= 12.0 && v_currentHourOfDay < 13.0) {
        dailyBaseline = 0.2; // The Lunch Break slowdown
    } else {
        // Linear bell curve peaking at 11:00 AM
        double distanceFromPeak = Math.abs(v_currentHourOfDay - 11.0);
        dailyBaseline = 1.0 + Math.max(0, 1.5 - (distanceFromPeak / 3.0));
    }
}
v_microDailyMul = dailyBaseline;
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1778589839156</Id>
					<Name><![CDATA[getScheduleDescription]]></Name>
					<X>400</X><Y>1200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String desc = "Shift: ";

for (int h = 0; h < 24; h++) {
    if (workSchedule.getValue((double)h) > 0) {
        int start = h;
        
        while (h < 24 && workSchedule.getValue((double)h) > 0) {
            h++;
        }
        int end = h;
        
        desc += start + ":00 - " + end + ":00 | ";
    }
}

return desc.equals("Shift: ") ? "No active shifts" : desc;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779106286259</Id>
					<Name><![CDATA[getMarketIndex]]></Name>
					<X>1610</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double slowTrend = 50 + 15 * Math.sin(2 * Math.PI * time() / 8760);
double randomNoise = normal(0, 3); // AnyLogic's normal distribution (mean=0, stdev=3)
return slowTrend + randomNoise;]]></Body>
				</Function>
